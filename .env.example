# Final public origin, e.g. https://yangjeong-best-eye.vercel.app (no path/query).
# Vercel normalizes bare domains and falls back to its production domain if invalid.
# Leave blank locally.
SITE_URL=
# Set to off on staging; on does not override local-preview noindex.
SITE_INDEXING=off
# Paste verification tokens only (not the full HTML meta tag).
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
# Vercel: set these only in the project's private environment variables.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service-role JWT is also accepted if a secret key is unavailable.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
